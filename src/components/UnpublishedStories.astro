---
import Section from "./Section.astro";
---

<Section id="unpublished-stories" title="Offene Archiv-Beiträge">
  <div class="max-w-4xl mx-auto text-center">
    <div
      class="rounded-2xl border border-[#F4F4F4]/10 bg-gradient-to-b from-[#F4F4F4]/5 to-[#F4F4F4]/[0.02] p-8 backdrop-blur"
    >
      <h3 class="text-2xl font-bold mb-4">Material mit Quellen gesucht</h3>
      <p class="text-[#F4F4F4]/70 mb-6 max-w-2xl mx-auto">
        Diese Seite ergänzt nur Inhalte, deren Herkunft klar ist. Screenshots,
        Ergebnislisten, Kalender, Videos und Erinnerungen brauchen deshalb eine
        kurze Quellenangabe oder Kontextnotiz.
      </p>
    </div>
  </div>
</Section>
